{
  "name": "@p10i/do-md",
  "version": "1.4.1",
  "description": "Markdown template runtime and editing utilities",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "do-md": "bin/do-md.mjs",
    "do-md-mcp": "bin/do-md-mcp.mjs"
  },
  "main": "sources/index.mjs",
  "types": "sources/index.d.mts",
  "exports": {
    ".": {
      "types": "./sources/index.d.mts",
      "import": "./sources/index.mjs"
    },
    "./sources/*.mjs": {
      "types": "./sources/*.d.mts",
      "import": "./sources/*.mjs"
    },
    "./skills/do-md/SKILL.md": "./skills/do-md/SKILL.md",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "sources/",
    "docs/",
    "examples/",
    "skills/",
    "Dockerfile",
    "compose.example.yaml",
    ".dockerignore",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "docs": "node scripts/generate-reference.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "acorn": "8.15.0",
    "chalk": "^5.0.0",
    "fast-glob": "^3.3.3",
    "string-width": "4.2.3",
    "yaml": "^2.9.0",
    "yargs": "^17.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
