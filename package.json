{
  "name": "@p10i/do-md",
  "version": "1.0.0",
  "description": "Markdown template runtime and editing utilities",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "do-md": "bin/do-md.mjs",
    "do-md-mcp": "bin/do-md-mcp.mjs"
